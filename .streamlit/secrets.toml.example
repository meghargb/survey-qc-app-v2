# Copy this file to .streamlit/secrets.toml for local development
# (never commit the real secrets.toml - it's in .gitignore).
#
# On Streamlit Community Cloud: go to your app -> Settings -> Secrets,
# and paste the same key = "value" lines there instead of using this file.

# Only needed if you re-enable AI features later (currently disabled -
# see report_builder.py). Not required for normal use.
ANTHROPIC_API_KEY = "sk-ant-..."
AI_PROVIDER = "anthropic"

# Login is now per-person (email + password each person sets themselves
# on the "Create Account" tab) - there's nothing to configure here for
# login. Accounts are stored in the app's database.
