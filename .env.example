# Copy this file to ".env" (remove ".example") and fill in your own values.
# Only needed if you re-enable AI features later - not required to run the app.

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Login is per-person (email + password each person sets on the
# "Create Account" tab in the app) - nothing to configure here for login.
